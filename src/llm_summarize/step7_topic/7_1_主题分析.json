    "其他": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "内容": {"type": "string"},
          "引用": {
            "type": "array",
            "items": {"type": "integer", "minimum": 1}
          }
        },
        "required": ["内容", "引用"]
      }
