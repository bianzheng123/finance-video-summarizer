# ============================================================
# finance-video-summarizer 环境变量模板
# 用法：cp .env.example .env 后填入真实值
# ============================================================

# ---------- LLM（DeepSeek）----------
DEEPSEEK_API_KEY=
# 腾讯云混元 LLM（联网搜索 / 主题去重等阶段需要）
TENCENT_LLM_API_KEY=

# ---------- 腾讯云 ASR 语音识别（字幕识别必需）----------
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# 热词表 ID（可选，用于提升金融专有名词识别率）
TENCENT_HOTWORD_ID=

# ---------- 腾讯云 COS 对象存储（音频/字幕中转，必需）----------
TENCENT_COS_BUCKET=
TENCENT_COS_REGION=

# ---------- 并发与调优（可选，均带默认值）----------
# 联网搜索并发上限（默认 6）
WSA_MAX_CONCURRENCY=6
# 全局线程池 worker 数（默认按各模型限额之和自动计算）
# SHARED_EXECUTOR_MAX_WORKERS=
# 各模型 LLM 并发上限，JSON 字典（默认 deepseek-v4-flash=2500 / deepseek-v4-pro=500）
# LLM_MODEL_CONCURRENCY={"deepseek-v4-flash":2500,"deepseek-v4-pro":500}
# 前缀预热阶段列表（逗号分隔的精确 N_M / N_M_K 键，控制哪些 LLM 阶段做「串行首请求写缓存」预热）。
# 未设置时使用代码内置默认名单（见 src/llm_infra/gate.py 的 _DEFAULT_WARMUP_STAGES），开箱即预热；
# 显式设为空（WARMUP_STAGES=）可禁用预热。默认名单示例（含三级键 4_5_1/4_5_2）：
# WARMUP_STAGES=1_1,1_2,2_1,2_2,2_3,3_1,3_2,4_2,4_3,4_4,4_5_1,4_5_2,4_6,4_7,5_1,5_2,5_3,6_1,6_2,6_3,7_1,7_2,7_4,8_1,8_2,8_3
